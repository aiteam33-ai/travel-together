# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# frontend (Next.js app in frontend/)
/frontend/node_modules
/frontend/.next

# backend (Python/FastAPI app in backend/)
/backend/.venv
